      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"projects\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL DEFAULT '', \"color\" TEXT NOT NULL DEFAULT 'charcoal', \"parent_id\" TEXT NULL, \"order_key\" TEXT NOT NULL DEFAULT '', \"is_favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_favorite\" IN (0, 1)), \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"is_inbox\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_inbox\" IN (0, 1)), \"view_style\" TEXT NOT NULL DEFAULT 'list', \"is_collapsed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_collapsed\" IN (0, 1)), \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"content\" TEXT NOT NULL DEFAULT '', \"description\" TEXT NOT NULL DEFAULT '', \"project_id\" TEXT NULL, \"section_id\" TEXT NULL, \"parent_id\" TEXT NULL, \"order_key\" TEXT NOT NULL DEFAULT '', \"priority\" INTEGER NOT NULL DEFAULT 4, \"due_date\" TEXT NULL, \"due_time\" TEXT NULL, \"due_tz\" TEXT NULL, \"deadline_date\" TEXT NULL, \"duration_amount\" INTEGER NULL, \"duration_unit\" TEXT NULL, \"is_collapsed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_collapsed\" IN (0, 1)), \"is_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_completed\" IN (0, 1)), \"completed_at\" TEXT NULL, \"added_at\" TEXT NULL, \"deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"deleted\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
