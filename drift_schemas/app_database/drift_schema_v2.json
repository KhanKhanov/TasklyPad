      "name": "ops",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ops\" (\"op_id\" TEXT NOT NULL, \"node_id\" TEXT NOT NULL, \"hlc\" TEXT NOT NULL, \"base\" TEXT NULL, \"entity_type\" TEXT NOT NULL, \"entity_id\" TEXT NOT NULL, \"field\" TEXT NOT NULL, \"value_json\" TEXT NOT NULL, PRIMARY KEY (\"op_id\"));"
        }
      ]
    },
    {
